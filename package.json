{
  "name": "@factory/core",
  "version": "0.0.0-cp00",
  "private": true,
  "type": "module",
  "bin": {
    "factory": "./dist/src/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test \"dist/test/**/*.test.js\"",
    "format": "prettier --write \"{src,test,scripts,.github,schemas}/**/*.{ts,js,mjs,yml,yaml,json}\" \"*.json\" \"docs/probes/*.md\" \"docs/superpowers/plans/*.md\"",
    "format:check": "prettier --check \"{src,test,scripts,.github,schemas}/**/*.{ts,js,mjs,yml,yaml,json}\" \"*.json\" \"docs/probes/*.md\" \"docs/superpowers/plans/*.md\"",
    "lint": "node scripts/lint.mjs",
    "proof:cp06:ten-pack": "npm run build && node scripts/replay-cp06-ten-pack.mjs",
    "proof:cp06:p07": "node scripts/replay-cp06-p07.mjs",
    "proof:cp06:worker": "node scripts/replay-cp06-worker.mjs",
    "factory": "node dist/src/cli.js"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "26.6.3",
    "prettier": "3.9.9",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "yaml": "2.9.1"
  }
}
