{
  "name": "@factory/core",
  "version": "0.0.0-cp00",
  "private": true,
  "type": "module",
  "bin": {
    "factory": "./dist/src/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test \"dist/test/**/*.test.js\"",
    "format": "prettier --write \"{src,test,scripts,.github}/**/*.{ts,js,mjs,yml,yaml}\" \"*.json\" \"docs/probes/CP-00.md\"",
    "format:check": "prettier --check \"{src,test,scripts,.github}/**/*.{ts,js,mjs,yml,yaml}\" \"*.json\" \"docs/probes/CP-00.md\"",
    "lint": "node scripts/lint.mjs",
    "factory": "node dist/src/cli.js"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "26.6.3",
    "prettier": "3.9.9",
    "typescript": "7.0.2"
  }
}
