{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "name",
    "intent",
    "audience",
    "goals",
    "non_goals",
    "constraints",
    "documents",
    "completion"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,63}$" },
    "name": { "type": "string", "minLength": 1 },
    "intent": { "type": "string", "minLength": 1 },
    "audience": { "type": "string", "minLength": 1 },
    "goals": { "$ref": "#/definitions/statements" },
    "non_goals": { "$ref": "#/definitions/statements" },
    "constraints": { "$ref": "#/definitions/statements" },
    "documents": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required"],
      "properties": { "required": { "$ref": "#/definitions/paths" } }
    },
    "completion": { "type": "string", "minLength": 1 },
    "metadata": { "type": "object" }
  },
  "definitions": {
    "statements": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "paths": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    }
  }
}
