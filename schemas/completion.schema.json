{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project", "conditions"],
  "properties": {
    "schema_version": { "const": 1 },
    "project": { "type": "string", "minLength": 1 },
    "conditions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "outcome", "method", "evidence"],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9-]{1,63}$" },
          "outcome": { "type": "string", "minLength": 1 },
          "method": { "enum": ["executable", "observation"] },
          "check_id": { "type": "string", "minLength": 1 },
          "protocol": { "type": "string", "minLength": 1 },
          "evidence": { "type": "string", "minLength": 1 },
          "metadata": { "type": "object" }
        },
        "allOf": [
          {
            "if": { "properties": { "method": { "const": "executable" } } },
            "then": { "required": ["check_id"] }
          },
          {
            "if": { "properties": { "method": { "const": "observation" } } },
            "then": { "required": ["protocol"] }
          }
        ]
      }
    },
    "metadata": { "type": "object" }
  }
}
