{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "title",
    "outcome",
    "depends_on",
    "complexity",
    "risk",
    "acceptance",
    "advances",
    "context",
    "evidence"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "id": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9-]{1,63}$" },
    "title": { "type": "string", "minLength": 1 },
    "outcome": { "type": "string", "minLength": 1 },
    "kind": { "enum": ["ship", "enabling"] },
    "depends_on": { "$ref": "#/definitions/ids" },
    "complexity": { "enum": ["bounded", "normal", "critical"] },
    "risk": { "enum": ["bounded", "normal", "critical"] },
    "acceptance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "statement"],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9-]{1,63}$" },
          "statement": { "type": "string", "minLength": 1 }
        }
      }
    },
    "advances": { "$ref": "#/definitions/ids" },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["topics", "required"],
      "properties": {
        "topics": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "required": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required"],
      "properties": {
        "required": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      }
    },
    "delivery": { "type": "string", "minLength": 1 },
    "metadata": { "type": "object" }
  },
  "definitions": {
    "ids": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
  }
}
