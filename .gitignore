models/**/*.gguf
models/**/*.safetensors
models/**/*.ckpt
models/**/*.pt
models/**/*.pth
models/**/*.onnx
models/**/*.tflite
.factory/state/models/

# Environment/secrets
.env
.env.*
!.env.example
